# Settings for the app. On Cloudflare they go in two places (see README):
#   Build variables: Workers > coaching-circle > Settings > Build > Variables and secrets
#   Runtime:         Workers > coaching-circle > Settings > Variables and Secrets
# For local development, copy this file to .dev.vars (and .env.local) and fill it in.

# --- Build AND runtime. From Supabase > Project Settings > API. Not secret.
NEXT_PUBLIC_SUPABASE_URL=https://riqhxofpqynahmdvquan.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Build only, optional. Sign-in buttons: google, azure (Microsoft), apple.
NEXT_PUBLIC_AUTH_PROVIDERS=google

# --- Runtime secrets (add as type "Secret").
# Used to send invites and the weekly reminder emails.
SUPABASE_SERVICE_ROLE_KEY=
# Gmail address and app password (Google account > Security > App passwords).
SMTP_USER=
SMTP_PASS=

# --- Runtime, not secret.
# The app's address, used in invite and reminder emails.
SITE_URL=https://coaching-circle.YOUR-ACCOUNT.workers.dev
# Booking links for "Feeling stuck? Book a call".
FREE_CALL_URL=
PAID_CALL_URL=

# Already set in wrangler.jsonc (change them there):
# COACH_NAME, SMTP_HOST, SMTP_PORT, REMINDER_FROM_NAME, REMINDER_TIMEZONE.
# The reminder send time is "triggers" in wrangler.jsonc, in UTC.
